{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dwellingdesign",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "require('http').createServer((req,res)=>{const fs=require('fs'),path=require('path');let f=path.join('C:/Users/cb/dwellingdesign-v2',req.url==='/'?'index.html':req.url);fs.readFile(f,(e,d)=>{if(e){res.writeHead(404);res.end()}else{const ext=path.extname(f);const m={'html':'text/html','jpg':'image/jpeg','jpeg':'image/jpeg','webp':'image/webp','png':'image/png','css':'text/css','js':'application/javascript'};res.writeHead(200,{'Content-Type':m[ext.slice(1)]||'text/plain'});res.end(d)}})}).listen(7788)"],
      "port": 7788
    }
  ]
}
